{
  "name": "clanker-mcp-server",
  "version": "0.3.9",
  "description": "Thin MCP job controller for Codex, OpenCode, Grok, and Gemini over ACP",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "clanker-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "bundle": "npm run bundle:skills && npm run bundle:dist",
    "bundle:skills": "node scripts/sync-plugin-skills.mjs",
    "bundle:dist": "tsx scripts/bundle.ts",
    "clean": "rm -rf dist plugin/dist codex-plugin/dist",
    "typecheck": "tsc --noEmit",
    "test": "rm -rf .test-tmp/runs .test-tmp/worktrees .test-tmp/ledger && CLANKER_RUNS_ROOT=\"$PWD/.test-tmp/runs\" CLANKER_WORKTREES_ROOT=\"$PWD/.test-tmp/worktrees\" CLANKER_LEDGER_DIR=\"$PWD/.test-tmp/ledger\" node --import tsx/esm --test test/*.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@agentclientprotocol/codex-acp": "1.1.4",
    "@agentclientprotocol/sdk": "1.1.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "esbuild": "0.25.12",
    "tsx": "4.20.6",
    "typescript": "7.0.2"
  }
}
