{
  "name": "clanker-mcp-server",
  "version": "0.1.5",
  "description": "Unified MCP plugin driving Codex, Opencode, and Grok Clankers over ACP (Agent Client Protocol)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "clanker-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=plugin/dist/clanker-mcp.mjs --banner:js=\"// GENERATED by 'npm run bundle' (esbuild). Do not edit — edit src/ and rebuild.\"",
    "clean": "rm -rf dist plugin/dist",
    "typecheck": "tsc --noEmit",
    "test": "CLANKER_RUNS_ROOT=\"$PWD/.test-tmp/runs\" CLANKER_WORKTREES_ROOT=\"$PWD/.test-tmp/worktrees\" node --import tsx/esm --test test/*.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@agentclientprotocol/codex-acp": "1.1.4",
    "@agentclientprotocol/sdk": "1.1.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "esbuild": "0.25.12",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
